    "test:cobertura": "node scripts/test.js --cobertura",
    "check": "node scripts/check.js",
    "ejemplo": "node scripts/generar-ejemplo.js",
    "ejemplo:comprobar": "node scripts/generar-ejemplo.js --comprobar",
    "test:e2e": "node scripts/test.js test/e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }

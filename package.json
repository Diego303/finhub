{
  "name": "finhub",
  "version": "0.0.0",
  "private": true,
  "description": "Tu dinero en local: gastos, cartera, metas, herramientas, descubrimientos y una base de conocimiento financiero en Markdown, con Rex y Claude Code solo cuando tú das luz verde.",
  "type": "module",
  "bin": {
    "finhub": "bin/finhub.js"
  },
  "engines": {
